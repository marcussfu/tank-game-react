{
  "name": "@tank/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Headless Node runtime for the Tank War Engine — a fixed-interval tick loop replacing the browser's RAF loop. Groundwork for server-authoritative network multiplayer (M-MP-3+).",
  "main": "src/index.ts",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.125.0",
    "@hono/node-server": "^2.1.1",
    "hono": "^4.13.7",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/ws": "^8.5.13",
    "tsx": "^4.20.6"
  }
}
