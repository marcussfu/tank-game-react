{
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023"],
    "module": "ESNext",
    "skipLibCheck": true,

    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,

    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "erasableSyntaxOnly": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedSideEffectImports": true,

    "types": ["node"]
  },
  // The engine is consumed straight from the web app's source tree (it is
  // pure, framework-free TS) rather than duplicated or pre-built. Only the
  // engine + its lone shared-types file are pulled in — not the React code.
  "include": ["src/**/*", "../src/engine/**/*", "../src/types/**/*", "../src/net/**/*"]
}
